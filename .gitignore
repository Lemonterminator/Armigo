# Graphify local caches, interpreter paths, and dated snapshots.
graphify-out/*
!graphify-out/graph.json
!graphify-out/graph.html
!graphify-out/GRAPH_REPORT.md

# MLflow local store and rendered anomaly datasets (several GB; regenerate with scripts/anomaly/render_dataset.py)
mlflow/
results/anomaly/dataset-*/
results/anomaly/*.log
# Agent bench: full run folders, recorded videos and the machine-specific detector spec stay local.
results/agent-bench/before/
results/agent-bench/final/
results/agent-bench/perception/runs/
results/agent-bench/videos/*.mp4
results/agent-bench/sup-local.json
