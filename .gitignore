__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ruff_cache/
.venv/
*.blend1
results/stage2/demos/
results/real_ref/*.png
uv-cache/
# written next to so101.xml by the MuJoCo cell
assets/so101_mjcf/_marker_*.png
assets/so101_mjcf/_sorting_cell_*.xml
# Local recordings and simulator logs; compact verification reports stay versionable.
results/verification-*/data/
results/verification-*/*.log
results/verification-*/isaac*/
results/verification-*/*.pstats

# Graphify local caches, interpreter paths, and dated snapshots.
graphify-out/*
!graphify-out/graph.json
!graphify-out/graph.html
!graphify-out/GRAPH_REPORT.md
