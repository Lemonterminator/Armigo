    def Scope "Looks"
    {
        def Material "Brick_mat"
        {
            token outputs:surface.connect = </Brick/Looks/Brick_mat/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82, 0.24, 0.04)
                float inputs:ior = 1.49
                float inputs:metallic = 0
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }

        def Material "defect_mat"
        {
            token outputs:surface.connect = </Brick/Looks/defect_mat/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.02, 0.02, 0.02)
                float inputs:ior = 1.49
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
    }

