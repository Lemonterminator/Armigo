    def Scope "Looks"
    {
        def Material "Brick_mat"
        {
            token outputs:surface.connect = </Brick/Looks/Brick_mat/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82, 0.24, 0.04)
                float inputs:ior = 1.49
                float inputs:metallic = 0
                float inputs:roughness = 0.2
                token outputs:surface
            }
        }

        def Material "defect_mat"
        {
            token outputs:surface.connect = </Brick/Looks/defect_mat/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.02, 0.02, 0.02)
                float inputs:ior = 1.49
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
    }

    def Material "PhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.35
        float physics:restitution = 0.05
        float physics:staticFriction = 0.4
        custom token physxMaterial:frictionCombineMode = "max"
        custom token physxMaterial:restitutionCombineMode = "max"
    }

    def Cube "Defect_0" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Brick/Looks/defect_mat>
        double size = 1
        quatf xformOp:orient = (0.27059805, 0.6532815, 0.27059805, 0.6532815)
        float3 xformOp:scale = (0.01900703, 0.0022, 0.0008)
        double3 xformOp:translate = (0.0323, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "Defect_1" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Brick/Looks/defect_mat>
        double size = 1
