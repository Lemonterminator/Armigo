#usda 1.0
(
    defaultPrim = "so101"
    metersPerUnit = 1
    subLayers = [
        @./so101.usda@
    ]
    upAxis = "Z"
)

over "so101"
{
    over "Geometry"
    {
        over "base"
        {
            over "shoulder"
            {
                over "upper_arm"
                {
                    over "lower_arm"
                    {
                        over "wrist"
                        {
                            over "gripper"
                            {
                                over "wrist_roll_follower_so101_gripper_part0_v1" (
                                    prepend apiSchemas = ["PhysicsMeshCollisionAPI"]
                                )
                                {
                                    uniform token physics:approximation = "convexDecomposition"
                                }

                                over "moving_jaw_so101_v1"
                                {
                                    over "moving_jaw_so101_gripper_part0_v1" (
                                        prepend apiSchemas = ["PhysicsMeshCollisionAPI"]
                                    )
                                    {
                                        uniform token physics:approximation = "convexDecomposition"
                                    }

                                    over "moving_jaw_so101_gripper_part1_v1" (
                                        prepend apiSchemas = ["PhysicsMeshCollisionAPI"]
                                    )
                                    {
                                        uniform token physics:approximation = "convexDecomposition"
                                    }

                                    over "gripper" (
                                        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
                                    )
                                    {
                                        float drive:angular:physics:damping = 10
                                        float drive:angular:physics:maxForce = 2.94
                                        float drive:angular:physics:stiffness = 100
                                        uniform token drive:angular:physics:type = "force"
                                    }
                                }

                                over "wrist_roll" (
                                    prepend apiSchemas = ["PhysicsDriveAPI:angular"]
                                )
                                {
                                    float drive:angular:physics:damping = 10
                                    float drive:angular:physics:maxForce = 2.94
                                    float drive:angular:physics:stiffness = 100
                                    uniform token drive:angular:physics:type = "force"
                                }

                                over "camera_mount"
                                {
                                    def Camera "wrist_cam"
                                    {
                                        float2 clippingRange = (0.01, 10)
                                        float focalLength = 24
                                        float horizontalAperture = 37.69888
                                        float verticalAperture = 28.27416
                                        quatf xformOp:orient = (0.95828, -0.285792, -0.001556, 0.004547)
                                        double3 xformOp:translate = (-0.00296, 0.05436, -0.0531)
                                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
                                    }
                                }
                            }

                            over "wrist_flex" (
                                prepend apiSchemas = ["PhysicsDriveAPI:angular"]
                            )
                            {
                                float drive:angular:physics:damping = 10
                                float drive:angular:physics:maxForce = 2.94
                                float drive:angular:physics:stiffness = 100
                                uniform token drive:angular:physics:type = "force"
                            }
                        }

                        over "elbow_flex" (
                            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
                        )
                        {
                            float drive:angular:physics:damping = 10
                            float drive:angular:physics:maxForce = 2.94
                            float drive:angular:physics:stiffness = 100
                            uniform token drive:angular:physics:type = "force"
                        }
                    }

                    over "shoulder_lift" (
                        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
                    )
                    {
                        float drive:angular:physics:damping = 10
                        float drive:angular:physics:maxForce = 2.94
                        float drive:angular:physics:stiffness = 100
                        uniform token drive:angular:physics:type = "force"
                    }
                }

                over "shoulder_pan" (
                    prepend apiSchemas = ["PhysicsDriveAPI:angular"]
                )
                {
                    float drive:angular:physics:damping = 10
                    float drive:angular:physics:maxForce = 2.94
                    float drive:angular:physics:stiffness = 100
                    uniform token drive:angular:physics:type = "force"
                }
            }
        }
    }

    over "Physics"
    {
        over "PhysicsMaterial_1" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1.6
            float physics:restitution = 0
            float physics:staticFriction = 1.8
        }
    }
}

